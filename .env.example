# Google AI Studio / Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: override default model (default is gemini-2.5-flash — better free-tier support than 2.0-flash for many accounts).
# GEMINI_MODEL=gemini-2.0-flash

# Streamlit and tools that call the FastAPI server (default local dev)
BACKEND_URL=http://127.0.0.1:8000

# Optional: Vite dev server proxy for `npm run dev` in frontend/ (use local API)
# VITE_DEV_API_URL=http://127.0.0.1:8000
